# ---- WATCHTOWER local-only ----

# NEVER COMMIT KEYS (public OR private)
proofs/keys/**
!proofs/keys/.gitkeep

# Private keys must never be committed
proofs/keys/*
!proofs/keys/.gitkeep
!proofs/keys/*.pub

# Receipts are local append-only logs (do not commit contents)
proofs/receipts/*
!proofs/receipts/.gitkeep

# Derived / backup files
proofs/trust/*.bak_*
**/*.bak_*

# Local smoke-test payloads
proofs/test_payload.txt
proofs/test_payload.txt.sig

# Scratch scripts (kept locally, not committed)
scripts/_scratch/*
!scripts/_scratch/.gitkeep

# Packets (Packet Constitution v1): keep structure, ignore contents
packets/**
!packets/**/
!packets/**/.gitkeep


# local safety quarantine
_quarantine/


*.bak
scripts/_scratch/

proofs/progress/

# Node dependencies (never commit) — added by audit fix
node_modules/
**/node_modules/

# UI incremental build info
ui/tsconfig.tsbuildinfo

# ---- WatchTower v2 node state (when the repository root is used as the state root) ----
# Per-node, append-only evidence and keys: produced by `bin/watchtower.ps1`, never committed.
config/watchtower.settings.json
proofs/trust/neverlost/
proofs/alerts/
proofs/pledges/
runtime/

# Project-local scratch space (WatchTower never writes to %TEMP% or AppData)
.wt-tmp/

# Test reports written with -ReportPath
watchtower-test-run.json
test-report.json

# Project-local home for the v1 CLI install and inspector data (formerly %LOCALAPPDATA%\WatchTowerCLI
# and %LOCALAPPDATA%\WatchTowerInspector): machine-local, large, never committed
local/

# v1 inspector UI build output and bridge smoke/probe logs
ui/dist/
ui/src-tauri/target/
ui/workbench/*.stdout.txt
ui/workbench/*.stderr.txt
ui/workbench/*_probe.json
