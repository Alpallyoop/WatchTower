{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ScrappyHub/WatchTower/schemas/watchtower.telemetry.receipt.v1.json",
  "title": "Verifier receipt",
  "description": "One row of proofs/receipts/watchtower.telemetry.receipt.v1.ndjson per packet WatchTower processed, accepted or not. Rows are canonical JSON, hash-chained: receipt_hash = sha256(canonical_json(row without receipt_hash) + LF), prev_receipt_hash links to the previous row (GENESIS first). Consumers (live-state-surgeon) act only on verify_result = ok. Facts (health_status, compliance, hashes) are recorded only from bodies that passed validation. Strings that came from a producer are capped; unknown values are \"\" and seq is -1.",
  "type": "object",
  "required": [
    "schema",
    "receipt_time",
    "verifier",
    "verifier_key_id",
    "node_id",
    "packet_ref",
    "packet_id",
    "packet_kind",
    "event_type",
    "event_hash",
    "event_id",
    "producer",
    "producer_instance",
    "key_id",
    "namespace",
    "device_id",
    "producer_time",
    "seq",
    "verify_result",
    "fail_reason",
    "stage",
    "signer_verified",
    "health_status",
    "compliance",
    "policy_hash_claimed",
    "posture_hash",
    "policy_check",
    "policy_hash_expected",
    "disposition",
    "routed_to",
    "receipt_id",
    "prev_receipt_hash",
    "receipt_hash"
  ],
  "properties": {
    "schema": {
      "const": "watchtower.telemetry.receipt.v1"
    },
    "receipt_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "verifier": {
      "const": "single-tenant/watchtower_authority/authority/watchtower",
      "description": "WatchTower's NeverLost principal."
    },
    "verifier_key_id": {
      "const": "watchtower-authority-ed25519"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packet_ref": {
      "type": "string",
      "maxLength": 270
    },
    "packet_id": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "packet_kind": {
      "type": "string",
      "maxLength": 270
    },
    "event_type": {
      "type": "string",
      "maxLength": 270
    },
    "event_hash": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "event_id": {
      "type": "string",
      "maxLength": 270
    },
    "producer": {
      "type": "string",
      "maxLength": 270
    },
    "producer_instance": {
      "type": "string",
      "maxLength": 270
    },
    "key_id": {
      "type": "string",
      "maxLength": 270
    },
    "namespace": {
      "type": "string",
      "maxLength": 270
    },
    "device_id": {
      "type": "string",
      "maxLength": 270
    },
    "producer_time": {
      "type": "string",
      "maxLength": 270
    },
    "seq": {
      "type": "integer",
      "minimum": -1
    },
    "verify_result": {
      "enum": [
        "ok",
        "reject"
      ]
    },
    "fail_reason": {
      "type": "object",
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(NONE|[A-Z][A-Z0-9_]*)$"
        },
        "detail": {
          "type": "string",
          "maxLength": 526
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "enum": [
        "pcv1",
        "manifest",
        "event",
        "signature",
        "body",
        "complete",
        "state",
        "policy",
        "route",
        "record"
      ],
      "description": "Verification stage reached. 'record': the packet's own fields could not be recorded, so it was rejected with none of them (RECEIPT_UNRECORDABLE). 'policy': every WatchTower check passed and the policy gate (Arbiter) did not allow the packet."
    },
    "signer_verified": {
      "type": "boolean"
    },
    "health_status": {
      "enum": [
        "",
        "ok",
        "degraded",
        "fail"
      ]
    },
    "compliance": {
      "enum": [
        "",
        "compliant",
        "noncompliant"
      ]
    },
    "policy_hash_claimed": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "posture_hash": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "policy_check": {
      "enum": [
        "n/a",
        "unpinned",
        "match",
        "mismatch"
      ]
    },
    "policy_hash_expected": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "disposition": {
      "enum": [
        "accepted",
        "quarantined"
      ]
    },
    "routed_to": {
      "type": "string",
      "pattern": "^packets/(receipts|quarantine)/[^/]+$"
    },
    "policy_decision": {
      "type": "object",
      "description": "Present only when the policy gate is configured (settings.arbiter) and the packet passed every WatchTower check: the Arbiter decision WatchTower routed on (watchtower.policy_gate.v1). Hashes are Arbiter's (sha256: prefix) and are recomputed by WatchTower; the input, decision and policy snapshot are kept under proofs/policy/. integration_receipt_sha256 links the constellation.integration.receipt.v1 written for this exchange (proofs/integrations/watchtower__arbiter.ndjson).",
      "required": [
        "schema",
        "engine",
        "engine_version",
        "decision",
        "matched_rule_id",
        "reasons",
        "obligations",
        "policy_hash",
        "input_hash",
        "decision_hash",
        "outcome",
        "error_token",
        "integration_receipt_sha256"
      ],
      "properties": {
        "schema": {
          "const": "watchtower.policy_gate.v1"
        },
        "engine": {
          "const": "arbiter.v1"
        },
        "engine_version": {
          "type": "string",
          "maxLength": 64
        },
        "decision": {
          "enum": [
            "allow",
            "deny",
            "quarantine"
          ],
          "description": "Evaluator failures are recorded as deny (fail closed)."
        },
        "matched_rule_id": {
          "type": "string",
          "maxLength": 128
        },
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 142
          }
        },
        "obligations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 78
          },
          "description": "Obligation types of a quarantine decision; full obligations are in the quarantine note."
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "input_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "decision_hash": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "outcome": {
          "enum": [
            "ok",
            "refused",
            "unavailable",
            "unknown",
            "failed"
          ],
          "description": "constellation.integration.receipt.v1 outcome of the exchange."
        },
        "error_token": {
          "type": "string",
          "pattern": "^(|[A-Z][A-Z0-9_]*)$"
        },
        "integration_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256(canonical_json(row before receipt_id/receipt_hash) + LF)."
    },
    "prev_receipt_hash": {
      "type": "string",
      "pattern": "^(GENESIS|[0-9a-f]{64})$",
      "description": "Hash of the previous row; GENESIS for the first."
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verify_result": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "fail_reason": {
            "properties": {
              "code": {
                "const": "NONE"
              },
              "detail": {
                "const": ""
              }
            }
          },
          "disposition": {
            "const": "accepted"
          },
          "signer_verified": {
            "const": true
          },
          "stage": {
            "const": "complete"
          }
        }
      },
      "else": {
        "properties": {
          "fail_reason": {
            "properties": {
              "code": {
                "not": {
                  "const": "NONE"
                }
              }
            }
          },
          "disposition": {
            "const": "quarantined"
          }
        }
      }
    }
  ]
}
