{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ScrappyHub/WatchTower/schemas/watchtower.receipt_artifact.v1.json",
  "title": "Receipt Artifact v1 (payload/receipt.json)",
  "description": "docs/receipt_artifact_v1.md. receipt_id = sha256(canonical_json(receipt without receipt_id) + LF).",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_id",
    "kind",
    "refs",
    "ledger",
    "policy_ref",
    "created_at_utc",
    "signer_principal",
    "signer_key_id",
    "receipt_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "tenant_id": {
      "const": "single-tenant"
    },
    "kind": {
      "const": "attestation_ingest"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path",
          "sha256",
          "media_type"
        ],
        "properties": {
          "type": {
            "enum": [
              "transcript_slice",
              "checkpoint",
              "checkpoint_signature"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^payload/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "ledger": {
      "type": "object",
      "required": [
        "name",
        "first_index",
        "last_index",
        "head_hash"
      ],
      "properties": {
        "name": {
          "const": "watchtower.telemetry.receipt.v1"
        },
        "first_index": {
          "type": "integer",
          "minimum": 1
        },
        "last_index": {
          "type": "integer",
          "minimum": 1
        },
        "head_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "required": [
        "type",
        "sha256"
      ],
      "properties": {
        "type": {
          "const": "watchtower.settings.v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signer_principal": {
      "const": "single-tenant/watchtower_authority/authority/watchtower",
      "description": "WatchTower's NeverLost principal."
    },
    "signer_key_id": {
      "const": "watchtower-authority-ed25519"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
