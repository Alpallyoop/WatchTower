{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ScrappyHub/WatchTower/schemas/watchtower.policy_attest.v1.json",
  "title": "Verified policy attestation",
  "description": "Latest verified policy attestation per device. policy_ok is false when the producer reports noncompliance or the claimed policy hash differs from the pinned one. Properties after drift_reason were added in v2.0.0 (additive, optional).",
  "schema": "watchtower.policy_attest.v1",
  "type": "object",
  "required": [
    "schema",
    "device_id",
    "observed_utc",
    "policy_hash",
    "policy_ok"
  ],
  "properties": {
    "schema": {
      "const": "watchtower.policy_attest.v1"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_utc": {
      "type": "string",
      "minLength": 20
    },
    "policy_hash": {
      "type": "string",
      "minLength": 1
    },
    "policy_ok": {
      "type": "boolean"
    },
    "expected_policy_hash": {
      "type": "string"
    },
    "drift_reason": {
      "type": "string"
    },
    "proof_status": {
      "enum": [
        "verified",
        "self-check"
      ],
      "description": "verified: projected from a signer-verified telemetry receipt. self-check: WatchTower's own doctor."
    },
    "verification": {
      "type": "object",
      "description": "Who verified this document, when, and the receipt that authorises it. Absent receipt fields mean a self-check (doctor), not a producer observation.",
      "required": [
        "verifier",
        "verifier_key_id",
        "node_id",
        "verified_utc"
      ],
      "properties": {
        "verifier": {
          "const": "single-tenant/watchtower_authority/authority/watchtower",
          "description": "WatchTower's NeverLost principal."
        },
        "verifier_key_id": {
          "const": "watchtower-authority-ed25519"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "receipt_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packet_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "producer_instance": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "compliance": {
      "enum": [
        "compliant",
        "noncompliant"
      ]
    },
    "policy_check": {
      "enum": [
        "unpinned",
        "match",
        "mismatch"
      ]
    }
  }
}
