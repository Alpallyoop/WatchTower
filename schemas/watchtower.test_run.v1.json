{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ScrappyHub/WatchTower/schemas/watchtower.test_run.v1.json",
  "title": "Test run report",
  "description": "Written by tests/Invoke-WatchTowerTests.ps1 -ReportPath.",
  "type": "object",
  "required": [
    "schema",
    "generated_utc",
    "scope",
    "module_version",
    "powershell",
    "os",
    "repository_hash",
    "repo_mutated",
    "suites",
    "tokens"
  ],
  "properties": {
    "schema": {
      "const": "watchtower.test_run.v1"
    },
    "generated_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "scope": {
      "enum": [
        "standalone",
        "interop",
        "all"
      ]
    },
    "module_version": {
      "type": "string",
      "minLength": 1
    },
    "powershell": {
      "type": "object",
      "required": [
        "edition",
        "version"
      ],
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "os": {
      "type": "string",
      "minLength": 1
    },
    "repository_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repo_mutated": {
      "type": "boolean"
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "suite",
          "ok",
          "exit_code",
          "cases",
          "skipped",
          "token"
        ],
        "properties": {
          "suite": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          },
          "exit_code": {
            "type": "integer"
          },
          "cases": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "token": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
