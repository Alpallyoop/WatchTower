{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ScrappyHub/WatchTower/schemas/watchtower.quarantine_note.v1.json",
  "title": "Quarantine note",
  "description": "packets/quarantine/<name>.rejection.json beside each rejected packet.",
  "type": "object",
  "required": [
    "schema",
    "packet_ref",
    "code",
    "receipt_hash",
    "receipt_time"
  ],
  "properties": {
    "schema": {
      "const": "watchtower.quarantine_note.v1"
    },
    "packet_ref": {
      "type": "string",
      "maxLength": 270
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "additionalProperties": false
}
